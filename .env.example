PORT=8080
BASE_URL=http://localhost:8080
# Exactly 32 characters. Generate with: openssl rand -hex 16
LIMEN_SECRET=replace-with-32-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ENABLED=true
AUTH_PASSWORD_ENABLED=true
# Comma-separated admin emails with full control over all trees and users.
# On a non-local BASE_URL, the first account must use one of these emails.
ADMIN_EMAILS=
# Allow `zer seed` on a non-local BASE_URL. Keep this disabled in production.
ZER_ALLOW_DEMO_SEED=0
